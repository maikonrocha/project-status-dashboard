# Environment Variables Template

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dashboard_v3"

# Backend
PORT=3005
JWT_SECRET=your-secret-key-change-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3005/api

# Jira Cloud API (basic auth — used for importing issues)
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token
JIRA_CLOUD_INSTANCE_URL=https://yourcompany.atlassian.net
