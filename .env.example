# Environment Variables Template

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dashboard_v3"
POSTGRES_PASSWORD=change-me-in-production

# Backend
PORT=3005
FRONTEND_URL=http://localhost:3002

# API Key (shared secret for frontend-backend communication)
API_KEY=change-me-in-production
NEXT_PUBLIC_API_KEY=change-me-in-production

# Jira Cloud API (basic auth — used for importing issues)
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token
JIRA_CLOUD_INSTANCE_URL=https://yourcompany.atlassian.net
